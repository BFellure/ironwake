---
permalink: "notes/{{ page.fileSlug | slugify }}/"
---
<!DOCTYPE html>
<html lang="{{ meta.mainLanguage }}">
  <head>
    <title>{% if title %}{{ title }}{% else %}{{ page.fileSlug }}{% endif %}</title>
    {%include "components/pageheader.njk"%}
    {% set slotName = "common.head" %}{% include "components/pluginSlot.njk" %}
    {% set slotName = "notes.head" %}{% include "components/pluginSlot.njk" %}
    {% for imp in dynamics.common.head %}
      {% include imp %}
    {% endfor %}
    {% for imp in dynamics.notes.head %}
      {% include imp %}
    {% endfor %}
  </head>
  <body class="theme-{{meta.baseTheme}} markdown-preview-view markdown-rendered markdown-preview-section {% if settings.dgShowFileTree !== true %}no-filetree{% endif %} {% if settings.dgHomeLink === true and settings.dgShowFileTree !== true %}has-navbar{% endif %} {{meta.bodyClasses}}">
    {%include "components/notegrowthhistory.njk"%}

    {% set regionName = "navigation" %}
    {% set regionFallback = "components/navbar.njk" %}
    {% include "components/pluginRegion.njk" %}

    <main class="content cm-s-obsidian print {{contentClasses}}">
      <header>
        {% if settings.dgShowInlineTitle === true %}
          <h1 data-note-icon="{% if noteIcon %}{{noteIcon}}{% else %}{{meta.noteIconsSettings.default}}{% endif %}">{% if title %}{{ title }}{% else %}{{ page.fileSlug }}{% endif %}</h1>
        {% endif %}
        <div class="header-meta">
          {% if settings.dgShowTags === true and tags %}
            <div class="header-tags">
              {% for tag in tags %}
                {% if tag != 'gardenEntry' and tag !='note' %}
                  <a class="tag">
                    #{{tag}}
                  </a>
                {% endif %}
              {% endfor %}
            </div>
          {% endif %}
        </div>
      {% set slotName = "common.header" %}{% include "components/pluginSlot.njk" %}
      {% set slotName = "notes.header" %}{% include "components/pluginSlot.njk" %}
      {% for imp in dynamics.common.header %}
        {% include imp %}
      {% endfor %}
      {% for imp in dynamics.notes.header %}
        {% include imp %}
      {% endfor %}
      </header>
      {% set slotName = "common.beforeContent" %}{% include "components/pluginSlot.njk" %}
      {% set slotName = "notes.beforeContent" %}{% include "components/pluginSlot.njk" %}
      {% for imp in dynamics.common.beforeContent %}
        {% include imp %}
      {% endfor %}
      {% for imp in dynamics.notes.beforeContent %}
        {% include imp %}
      {% endfor %}
      {{ content | hideDataview | taggify | link | resolveMdLinks | safe}}
      {% set slotName = "common.afterContent" %}{% include "components/pluginSlot.njk" %}
      {% set slotName = "notes.afterContent" %}{% include "components/pluginSlot.njk" %}
      {% for imp in dynamics.common.afterContent %}
        {% include imp %}
      {% endfor %}
      {% for imp in dynamics.notes.afterContent %}
        {% include imp %}
      {% endfor %}
    </main>

    {% if settings.dgShowBacklinks === true or settings.dgShowLocalGraph === true or settings.dgShowToc === true or dynamics.sidebar.top.length > 0 or dynamics.sidebar.bottom.length > 0 or plugins.slots["sidebar.top"] or plugins.slots["sidebar.bottom"] %}
      {%include "components/sidebar.njk"%}
    {% endif %}
    {% include "components/floatingActions.njk" %}

    {% include "components/references.njk" %}
    {% set slotName = "common.footer" %}{% include "components/pluginSlot.njk" %}
    {% set slotName = "notes.footer" %}{% include "components/pluginSlot.njk" %}
    {% for imp in dynamics.common.footer %}
      {% include imp %}
    {% endfor %}
    {% for imp in dynamics.notes.footer %}
      {% include imp %}
    {% endfor %}
    {%include "components/lucideIcons.njk"%}
    {% if contentClasses and "canvas-page" in contentClasses %}
      {%include "components/canvasScript.njk"%}
    {% endif %}
    {% include "components/basesScript.njk" %}
    {% include "components/excalidrawScript.njk" %}

   {% raw %}
    <script>
    document.addEventListener("DOMContentLoaded", async () => {
        if (window.location.hostname === "localhost" || window.location.hostname === "127.0.0.1") return;

        let container = document.getElementById("vercel-logs-container");
        if (!container) return;

        let currentBuildName = document.querySelector("h1")?.innerText?.trim() || "";
        if (!currentBuildName) {
            container.innerHTML = `
                <div class="callout is-collapsed" data-callout="info" data-callout-fold="-">
                    <div class="callout-title" onclick="let p = this.parentElement; p.classList.toggle('is-collapsed');">
                        <div class="callout-icon"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-clock"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg></div>
                        <div class="callout-title-inner">Logs</div>
                        <div class="callout-fold"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down"><path d="m6 9 6 6 6-6"/></svg></div>
                    </div>
                    <div class="callout-content"><p><em>Could not determine note name.</em></p></div>
                </div>`;
            return;
        }

        try {
            let response = await fetch('/searchIndex.json');
            if (!response.ok) {
                response = await fetch('/contentIndex.json');
            }
            if (!response.ok) throw new Error("Could not find site search index JSON.");
            
            let index = await response.json();
            let pages = Array.isArray(index) ? index : Object.values(index);

            // Matches: minecraft/logs/building&region logs/[note name] logs/
            let targetFolder = `minecraft/logs/building&region logs/${currentBuildName.toLowerCase()} logs`;
            
            let logs = pages.filter(page => {
                let urlStr = (page.url || page.permalink || page.path || "").toLowerCase();
                return urlStr.includes(targetFolder);
            });

            logs.sort((a, b) => {
                let dateA = new Date(a.date || a.fileSlug || 0);
                let dateB = new Date(b.date || b.fileSlug || 0);
                return dateB - dateA;
            });

            let totalHours = 0;
            logs.forEach(item => {
                let textContent = item.content || "";
                let hoursMatch = textContent.match(/logged-hours[:\s]+([\d\.]+)/i);
                if (hoursMatch) {
                    totalHours += parseFloat(hoursMatch[1]) || 0;
                }
            });

            let html = `
            <div class="callout is-collapsed" data-callout="info" data-callout-fold="-">
                <div class="callout-title" onclick="let p = this.parentElement; p.classList.toggle('is-collapsed');">
                    <div class="callout-icon"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-clock"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg></div>
                    <div class="callout-title-inner">Logs</div>
                    <div class="callout-fold"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down"><path d="m6 9 6 6 6-6"/></svg></div>
                </div>
                <div class="callout-content">
                    <p><strong>⏱️ Total Time Invested: ${totalHours.toFixed(1)} hrs (${logs.length} log${logs.length === 1 ? '' : 's'})</strong></p>`;

            if (logs.length === 0) {
                html += `<p><em>No logs recorded for this note yet.</em></p></div></div>`;
                container.innerHTML = html;
                return;
            }

            logs.forEach(item => {
                let url = item.url || item.permalink || `#`;
                let textContent = item.content || "";
                
                let hoursMatch = textContent.match(/logged-hours[:\s]+([\d\.]+)/i);
                let hoursStr = hoursMatch ? ` <em>(${parseFloat(hoursMatch[1]).toFixed(1)} hrs)</em>` : "";
                
                let categoryMatch = textContent.match(/category[:\s]+([a-zA-Z]+)/i);
                let category = categoryMatch ? categoryMatch[1] : "Building";

                // Parse date if available in fileSlug or frontmatter, fallback to current formatting style
                let rawDate = item.date ? new Date(item.date) : new Date();
                let dateFormatted = !isNaN(rawDate) ? rawDate.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' }) + ' at ' + rawDate.toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit' }) : "Recent";

                html += `
                <div class="callout" data-callout="example" style="margin: 8px 0;">
                    <div class="callout-content" style="padding: 8px 12px;">
                        📄 <a href="${url}"><strong>${category} Log</strong></a> — 📅 ${dateFormatted}${hoursStr}
                    </div>
                </div>`;
            });

            html += `</div></div>`;
            container.innerHTML = html;
        } catch (err) {
            console.error("Logs loader error:", err);
            container.innerHTML = `
                <div class="callout is-collapsed" data-callout="info" data-callout-fold="-">
                    <div class="callout-title" onclick="let p = this.parentElement; p.classList.toggle('is-collapsed');">
                        <div class="callout-icon"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-clock"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg></div>
                        <div class="callout-title-inner">Logs</div>
                        <div class="callout-fold"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down"><path d="m6 9 6 6 6-6"/></svg></div>
                    </div>
                    <div class="callout-content"><p><em>Unable to load logs.</em></p></div>
                </div>`;
        }
    });
    </script>
    {% endraw %}
  </body>
</html>
