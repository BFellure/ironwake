---
permalink: "notes/{{ page.fileSlug | slugify }}/"
---
<!DOCTYPE html>
<html lang="{{ meta.mainLanguage }}">
  <head>
    <title>{% if title %}{{ title }}{% else %}{{ page.fileSlug }}{% endif %}</title>
    {%include "components/pageheader.njk"%}
    {% set slotName = "common.head" %}{% include "components/pluginSlot.njk" %}
    {% set slotName = "notes.head" %}{% include "components/pluginSlot.njk" %}
    {% for imp in dynamics.common.head %}
      {% include imp %}
    {% endfor %}
    {% for imp in dynamics.notes.head %}
      {% include imp %}
    {% endfor %}
  </head>
  <body class="theme-{{meta.baseTheme}} markdown-preview-view markdown-rendered markdown-preview-section {% if settings.dgShowFileTree !== true %}no-filetree{% endif %} {% if settings.dgHomeLink === true and settings.dgShowFileTree !== true %}has-navbar{% endif %} {{meta.bodyClasses}}">
    {%include "components/notegrowthhistory.njk"%}

    {% set regionName = "navigation" %}
    {% set regionFallback = "components/navbar.njk" %}
    {% include "components/pluginRegion.njk" %}

    <main class="content cm-s-obsidian print {{contentClasses}}">
      <header>
        {% if settings.dgShowInlineTitle === true %}
          <h1 data-note-icon="{% if noteIcon %}{{noteIcon}}{% else %}{{meta.noteIconsSettings.default}}{% endif %}">{% if title %}{{ title }}{% else %}{{ page.fileSlug }}{% endif %}</h1>
        {% endif %}
        <div class="header-meta">
          {% if settings.dgShowTags === true and tags %}
            <div class="header-tags">
              {% for tag in tags %}
                {% if tag != 'gardenEntry' and tag !='note' %}
                  <a class="tag">
                    #{{tag}}
                  </a>
                {% endif %}
              {% endfor %}
            </div>
          {% endif %}
        </div>
      {% set slotName = "common.header" %}{% include "components/pluginSlot.njk" %}
      {% set slotName = "notes.header" %}{% include "components/pluginSlot.njk" %}
      {% for imp in dynamics.common.header %}
        {% include imp %}
      {% endfor %}
      {% for imp in dynamics.notes.header %}
        {% include imp %}
      {% endfor %}
      </header>
      {% set slotName = "common.beforeContent" %}{% include "components/pluginSlot.njk" %}
      {% set slotName = "notes.beforeContent" %}{% include "components/pluginSlot.njk" %}
      {% for imp in dynamics.common.beforeContent %}
        {% include imp %}
      {% endfor %}
      {% for imp in dynamics.notes.beforeContent %}
        {% include imp %}
      {% endfor %}
      {{ content | hideDataview | taggify | link | resolveMdLinks | safe}}
      {% set slotName = "common.afterContent" %}{% include "components/pluginSlot.njk" %}
      {% set slotName = "notes.afterContent" %}{% include "components/pluginSlot.njk" %}
      {% for imp in dynamics.common.afterContent %}
        {% include imp %}
      {% endfor %}
      {% for imp in dynamics.notes.afterContent %}
        {% include imp %}
      {% endfor %}
    </main>

    {% if settings.dgShowBacklinks === true or settings.dgShowLocalGraph === true or settings.dgShowToc === true or dynamics.sidebar.top.length > 0 or dynamics.sidebar.bottom.length > 0 or plugins.slots["sidebar.top"] or plugins.slots["sidebar.bottom"] %}
      {%include "components/sidebar.njk"%}
    {% endif %}
    {% include "components/floatingActions.njk" %}

    {% include "components/references.njk" %}
    {% set slotName = "common.footer" %}{% include "components/pluginSlot.njk" %}
    {% set slotName = "notes.footer" %}{% include "components/pluginSlot.njk" %}
    {% for imp in dynamics.common.footer %}
      {% include imp %}
    {% endfor %}
    {% for imp in dynamics.notes.footer %}
      {% include imp %}
    {% endfor %}
    {%include "components/lucideIcons.njk"%}
    {% if contentClasses and "canvas-page" in contentClasses %}
      {%include "components/canvasScript.njk"%}
    {% endif %}
    {% include "components/basesScript.njk" %}
    {% include "components/excalidrawScript.njk" %}

   {% raw %}
    <script>
    document.addEventListener("DOMContentLoaded", async () => {
        // --- Debug Log Reporter ---
        const debugLogs = [];
        function logDebug(message, data = null) {
            const timestamp = new Date().toISOString().split('T')[1].slice(0, -1);
            const logEntry = `[${timestamp}] ${message}` + (data ? ` ${JSON.stringify(data)}` : '');
            debugLogs.push(logEntry);
            console.log(`[ChecklistDebug]`, message, data || '');
        }

        logDebug("DOMContentLoaded fired. Initializing script.");

        if (window.location.hostname === "localhost" || window.location.hostname === "127.0.0.1") {
            logDebug("Localhost environment detected. Aborting execution.");
            return;
        }

        let container = document.getElementById("vercel-checklists-container");
        logDebug("Container element lookup result:", { found: !!container, id: "vercel-checklists-container" });
        if (!container) return;

        let currentBuildName = document.querySelector("h1")?.innerText?.trim() || "";
        logDebug("Extracted current build name from <h1>:", { currentBuildName });

        if (!currentBuildName) {
            logDebug("Build name could not be determined. Rendering error callout.");
            container.innerHTML = `
                <div class="callout is-collapsed" data-callout="success" data-callout-fold="-">
                    <div class="callout-title" onclick="let p = this.parentElement; p.classList.toggle('is-collapsed');">
                        <div class="callout-icon"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-check"><path d="M20 6 9 17l-5-5"/></svg></div>
                        <div class="callout-title-inner">Checklists</div>
                        <div class="callout-fold"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down"><path d="m6 9 6 6 6-6"/></svg></div>
                    </div>
                    <div class="callout-content"><p><em>Could not determine build name.</em></p></div>
                </div>`;
            return;
        }

        try {
            logDebug("Fetching search index from /searchIndex.json");
            let response = await fetch('/searchIndex.json');
            if (!response.ok) {
                logDebug("searchIndex.json failed with status " + response.status + ". Falling back to /contentIndex.json");
                response = await fetch('/contentIndex.json');
            }
            if (!response.ok) throw new Error("Could not find site search index JSON.");
            
            let index = await response.json();
            let pages = Array.isArray(index) ? index : Object.values(index);
            logDebug("Search index loaded successfully.", { totalPages: pages.length });

            let targetFolder = `minecraft/checklists/builds/${currentBuildName.toLowerCase()}`;
            logDebug("Target folder constructed:", { targetFolder });

            let checklists = pages.filter(page => {
                let urlStr = (page.url || page.permalink || page.path || "").toLowerCase();
                return urlStr.includes(targetFolder) && urlStr.includes("checklist");
            });
            logDebug("Filtered checklists matching target folder and keyword:", { matchedCount: checklists.length });

            let html = `
            <div class="callout is-collapsed" data-callout="success" data-callout-fold="-">
                <div class="callout-title" onclick="let p = this.parentElement; p.classList.toggle('is-collapsed');">
                    <div class="callout-icon"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-check"><path d="M20 6 9 17l-5-5"/></svg></div>
                    <div class="callout-title-inner">Checklists</div>
                    <div class="callout-fold"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down"><path d="m6 9 6 6 6-6"/></svg></div>
                </div>
                <div class="callout-content">`;

            if (checklists.length === 0) {
                logDebug("No checklists found for this build. Appending empty state message.");
                html += `<p><em>No checklists created for this build yet.</em></p></div></div>`;
                
                // Append Debug Section to content
                html += `<hr style="border: none; border-top: 1px dashed var(--callout-border); margin: 12px 0;">
                         <details style="font-size: 11px; opacity: 0.8;"><summary><strong>🛠️ Checklist Debug Report</strong></summary><pre style="white-space: pre-wrap; margin-top: 6px;">${debugLogs.join('\n')}</pre></details>`;
                
                container.innerHTML = html;
                return;
            }

            let activeLists = [];
            let completedLists = [];

            checklists.forEach(item => {
                let textContent = item.content || "";
                
                // Extract status from text content (e.g. "Status: Completed")
                let statusMatch = textContent.match(/status[:\s]+([a-zA-Z]+)/i);
                let status = statusMatch ? statusMatch[1].toLowerCase() : "";

                // Extract progress from text content (e.g. "100.0%")
                let progressMatch = textContent.match(/(\d+(?:\.\d+)?%)/);
                let progress = progressMatch ? progressMatch[1] : "0.0%";

                // Attach parsed attributes to item for later use
                item.parsedStatus = status;
                item.parsedProgress = progress;

                if (status === "completed" || status === "complete" || progress === "100%" || progress === "100.0%") {
                    completedLists.push(item);
                } else {
                    activeLists.push(item);
                }
            });

            logDebug("Checklists categorized.", { activeCount: activeLists.length, completedCount: completedLists.length });

            html += `<p><strong>🔥 Active Checklists (${activeLists.length})</strong></p>`;
            
            if (activeLists.length > 0) {
                activeLists.forEach(item => {
                    let rawTitle = item.title || item.fileSlug || "Checklist";
                    let match = rawTitle.match(/^[^-]+-\s*(.*?)\s*Checklist$/i);
                    let projectName = match ? match[1] : rawTitle;
                    let url = item.url || item.permalink || `#`;
                    
                    html += `
                    <div class="callout" data-callout="example" style="margin: 8px 0;">
                        <div class="callout-content" style="padding: 8px 12px;">
                            <a href="${url}"><strong>${projectName}</strong></a> — 📊 ${item.parsedProgress}
                        </div>
                    </div>`;
                });
            } else {
                html += `<p><em>No active checklists found.</em></p>`;
            }

            html += `<hr style="border: none; border-top: 1px solid var(--callout-border); margin: 12px 0;">`;

            html += `<p><strong>✅ Completed Checklists (${completedLists.length})</strong></p>`;
            if (completedLists.length > 0) {
                completedLists.forEach(item => {
                    let rawTitle = item.title || item.fileSlug || "Checklist";
                    let match = rawTitle.match(/^[^-]+-\s*(.*?)\s*Checklist$/i);
                    let projectName = match ? match[1] : rawTitle;
                    let url = item.url || item.permalink || `#`;
                    
                    html += `
                    <div class="callout" data-callout="example" style="margin: 8px 0;">
                        <div class="callout-content" style="padding: 8px 12px;">
                            <a href="${url}"><strong>${projectName}</strong></a> — 📊 ${item.parsedProgress}
                        </div>
                    </div>`;
                });
            } else {
                html += `<p><em>No completed checklists found.</em></p>`;
            }

            // Append Debug Report section inside the collapsible callout
            logDebug("Rendering complete HTML structure with debug logs report.");
            html += `<hr style="border: none; border-top: 1px dashed var(--callout-border); margin: 12px 0;">
                     <details style="font-size: 11px; opacity: 0.8;"><summary><strong>🛠️ Checklist Debug Report</strong></summary><pre style="white-space: pre-wrap; margin-top: 6px;">${debugLogs.join('\n')}</pre></details>`;

            html += `</div></div>`;
            container.innerHTML = html;
        } catch (err) {
            console.error("Checklist loader error:", err);
            logDebug("CRITICAL ERROR caught during execution: " + err.message);
            
            container.innerHTML = `
                <div class="callout is-collapsed" data-callout="success" data-callout-fold="-">
                    <div class="callout-title" onclick="let p = this.parentElement; p.classList.toggle('is-collapsed');">
                        <div class="callout-icon"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-check"><path d="M20 6 9 17l-5-5"/></svg></div>
                        <div class="callout-title-inner">Checklists</div>
                        <div class="callout-fold"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down"><path d="m6 9 6 6 6-6"/></svg></div>
                    </div>
                    <div class="callout-content">
                        <p><em>Unable to load checklists.</em></p>
                        <hr style="border: none; border-top: 1px dashed var(--callout-border); margin: 12px 0;">
                        <details style="font-size: 11px; opacity: 0.8;"><summary><strong>🛠️ Checklist Debug Report (Error State)</strong></summary><pre style="white-space: pre-wrap; margin-top: 6px;">${debugLogs.join('\n')}</pre></details>
                    </div>
                </div>`;
        }
    });
    </script>
{% endraw %}
  </body>
</html>
